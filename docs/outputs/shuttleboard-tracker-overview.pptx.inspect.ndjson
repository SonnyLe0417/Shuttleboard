{"kind":"textbox","id":"sh/b2dcz2xs","slide":2,"text":"ShuttleBoard unifies live scoring, match memory, personalized Elo, AI review, and next-session coaching.","textPreview":"ShuttleBoard unifies live scoring, match memory, personalized Elo, AI review, and next-session coaching.","textChars":104,"textLines":1,"bbox":[680,180,240,76]}
